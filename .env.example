# =============================================================================
# KMKB — contoh environment untuk development lokal
# Salin ke .env:  cp .env.example .env
# Lalu jalankan:  php artisan key:generate
# =============================================================================

# --- Aplikasi ---
APP_NAME="KMKB Application"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Harus sama dengan URL yang Anda buka di browser.
# Default `php artisan serve`: http://127.0.0.1:8000
APP_URL=http://127.0.0.1:8000

# Kosongkan di lokal kecuali asset di-host terpisah
ASSET_URL=

# --- Database utama (Laravel / KMKB) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kmkb_db
DB_USERNAME=root
DB_PASSWORD=

# Opsional: overrides host/user/pass di atas jika dipakai
# DATABASE_URL=mysql://user:pass@127.0.0.1:3306/kmkb_db

# Opsional: socket MySQL (mis. Homebrew di macOS)
# DB_SOCKET=/tmp/mysql.sock

# Opsional: jalur sertifikat CA untuk koneksi TLS ke MySQL
# MYSQL_ATTR_SSL_CA=

# --- Database SIMRS Khanza (read-only, via VPN/jaringan RS) ---
# Produksi RS: aktifkan HOSPITAL_DB_ENABLED dan isi host internal (mis. 172.16.1.251).
HOSPITAL_DB_ENABLED=false
HOSPITAL_DB_HOST=
HOSPITAL_DB_PORT=3306
HOSPITAL_DB_DATABASE=simsvbaru
HOSPITAL_DB_USERNAME=
HOSPITAL_DB_PASSWORD=
HOSPITAL_DB_CHARSET=utf8
HOSPITAL_DB_COLLATION=utf8_general_ci
HOSPITAL_DB_CONNECT_TIMEOUT=3
HOSPITAL_DB_AVAILABILITY_CACHE_SECONDS=30

# --- Database SIMRS (legacy / fallback jika HOSPITAL_DB_ENABLED=false) ---
# Isi credentials DB SIMRS Anda. Default database Khanza: simsvbaru (bukan "simrs").
SIMRS_DB_HOST=127.0.0.1
SIMRS_DB_PORT=3306
SIMRS_DB_DATABASE=simsvbaru
SIMRS_DB_USERNAME=root
SIMRS_DB_PASSWORD=
SIMRS_DATABASE_URL=
SIMRS_DB_SOCKET=
SIMRS_MYSQL_ATTR_SSL_CA=

# --- Logging ---
LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# --- Driver umum (lokal: tanpa Redis/Mail server wajib) ---
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# Email: `log` = masuk file log, tanpa Mailpit/SMTP
# Alternatif lokal: MAIL_MAILER=smtp, MAIL_HOST=127.0.0.1, MAIL_PORT=1025 (Mailpit)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Sanctum (SPA / cookie API) ---
# Domain/host yang dianggap “stateful”; harus mencakup host + port dev Anda
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000,::1

# --- AWS / S3 (opsional) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Vite (frontend) ---
VITE_APP_NAME="${APP_NAME}"

# Hanya jika dev server Vite tidak di http://127.0.0.1:5173 (mis. Docker):
# VITE_DEV_SERVER_URL=http://127.0.0.1:5173
